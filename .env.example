LITELLM_API_KEY=
LITELLM_BASE_URL=https://aiadda.kukufm.com/api/litellm/v1   # any OpenAI-compatible /chat/completions endpoint
LLM_MODEL=anthropic/claude-sonnet-5
LLM_FAST_MODEL=anthropic/claude-haiku-4-5
SESSION_SECRET=change-me
ADMIN_PASSWORD=change-me
APP_URL=http://localhost:3000                                 # optional on Vercel (falls back to the project's production URL)
# TURSO_DATABASE_URL=libsql://...   (unset = local file data/app.db)
# TURSO_AUTH_TOKEN=
# RESEND_API_KEY=                   (unset = emails only land in the in-app outbox)
# EMAIL_FROM="Mentor Connect <onboarding@resend.dev>"
# RESEND_API_KEY set => sign-in links are emailed and REQUIRED (unset => name + email sign-in, a prototype shortcut).
# REQUIRE_EMAIL_VERIFY=on|off          force the above either way
# ADMIN_ALERT_EMAIL=team@example.com   urgent flags (crisis messages, mentor no-shows) are emailed here
# ALERT_WEBHOOK_URL=https://hooks.slack.com/...   ...and/or POSTed as {"text": "..."} (Slack-compatible)
# DEMO_TOOLS=off                       hide the "pretend the call has happened" control
